{
  "name": "rocq-proof-term-stepper",
  "version": "1.0.0",
  "private": true,
  "description": "Step through how Rocq (formerly Coq) tactics build a proof term, using real Show Proof output.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepare:jscoq": "node scripts/copy-jscoq.mjs",
    "predev": "pnpm run prepare:jscoq",
    "dev": "vite",
    "prebuild": "pnpm run prepare:jscoq",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:gallery": "node scripts/gen-gallery.mjs",
    "check:native": "node scripts/check-native.mjs",
    "e2e": "node scripts/e2e.mjs",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "jscoq": "^0.17.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
