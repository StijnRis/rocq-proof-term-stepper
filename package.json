{
  "name": "rocq-proof-term-stepper",
  "version": "1.0.0",
  "private": true,
  "description": "Step through how Rocq (formerly Coq) tactics build a proof term, using real Show Proof output.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepare:jscoq": "node scripts/copy-jscoq.mjs",
    "predev": "pnpm run prepare:jscoq",
    "dev": "next dev",
    "prebuild": "pnpm run prepare:jscoq",
    "build": "next build",
    "start": "node scripts/serve.mjs out",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:gallery": "node scripts/gen-gallery.mjs",
    "check:native": "node scripts/check-native.mjs",
    "og": "node scripts/og.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jscoq": "^0.17.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
